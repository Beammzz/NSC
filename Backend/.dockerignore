# Build context hygiene. Everything listed here is either regenerated inside
# the image, local-only state, or a secret that must never reach a layer.

# Regenerated by the webui build stage.
**/node_modules
**/.next
webui/out
internal/webui/dist

# Local runtime state — the container keeps its SQLite database on a volume.
data/
*.db
*.db-wal
*.db-shm

# Secrets and local overrides. config.Load() reads ./.env, so a stray copy
# baked into the image would silently outrank the compose environment.
.env
.env.*
!.env.example

# Noise that would bust the build cache without changing the binary.
*.log
.git
AGENTS.md
Dockerfile
.dockerignore
