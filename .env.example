# SignMind deployment settings — used by example-compose.yaml.
#
#   cp .env.example .env
#
# Every value marked REQUIRED must be set: compose refuses to start without it,
# and the Go server calls log.Fatal in Prod for the two secrets. Never commit
# the filled-in .env.

# ---- REQUIRED ---------------------------------------------------------------

# Public hostname. Needs an A/AAAA record pointing at this host before the
# first start, or the ACME HTTP-01 challenge fails.
SIGNMIND_DOMAIN=signmind.example.com

# Contact address for the Let's Encrypt account (expiry notices go here).
ACME_EMAIL=admin@example.com

# HMAC-SHA256 signing key for access tokens. Rotating it invalidates every
# issued token AND makes the stored LLM API key underivable — it is the input
# to llm.DeriveEncryptionKey — so the key has to be re-entered after a change.
#   openssl rand -base64 48
SIGNMIND_JWT_SECRET=

# Shared secret on the backend -> inference gRPC link. Must be byte-identical
# in both services; the Python interceptor rejects every RPC otherwise. Unset
# leaves that link unauthenticated, so anyone reaching the port could replace
# the live model.
#   openssl rand -base64 32
SIGNMIND_AI_SHARED_SECRET=

# ---- OPTIONAL ---------------------------------------------------------------

# Seeds the first admin account on first boot, and is ignored on every later
# start once an admin exists. Leave both blank to create the account by hand.
SIGNMIND_ADMIN_EMAIL=
SIGNMIND_ADMIN_PASSWORD=

# Public POST /api/v1/auth/signup. Defaults to false here: the Go default is
# true, which would leave account creation open to the internet.
SIGNMIND_ALLOW_SIGNUP=false
