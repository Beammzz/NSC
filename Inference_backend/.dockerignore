# Build context hygiene for the inference image.

# Local envs and caches — never the ones the image installs.
.venv
venv
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
uv.lock

# Tests and dev-only tooling stay out of the runtime image.
tests/
pyrightconfig.json

# extract_keypoints.py is deliberately NOT excluded: the ExtractKeypoints RPC
# imports it, so it must be in the image (see the Dockerfile's extract extra).

*.log
.git
AGENTS.md
Dockerfile
.dockerignore
